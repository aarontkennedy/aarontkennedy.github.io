    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "leaflet-geosearch": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
